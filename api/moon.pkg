  "hc155-89/moontantivy",
  "hc155-89/moontantivy/index",
  "hc155-89/moontantivy/query",
  "hc155-89/moontantivy/score",
  "hc155-89/moontantivy/storage",
  "hc155-89/moontantivy/tokenizer",
  "moonbitlang/core/debug",
  "moonbitlang/x/fs",
}
